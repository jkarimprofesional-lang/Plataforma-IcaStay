generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  HOTEL_PARTNER
  ADMIN
}

enum Zone {
  HUACACHINA
  PARACAS
  ICA_CENTRO
  VINEDOS
  NAZCA
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  YAPE
  PLIN
  CARD
  TRANSFER
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  passwordHash     String
  role             Role      @default(GUEST)
  travelPreference String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hotels           Hotel[]
  bookings         Booking[]
  reviews          Review[]
}

model Hotel {
  id            Int       @id @default(autoincrement())
  name          String
  description   String
  zone          Zone
  pricePerNight Float
  imageUrl      String
  categoryTag   String
  isPartner     Boolean   @default(false)
  isAvailable   Boolean   @default(true) // RN-05: Control de cupos en tiempo real por el Partner
  externalUrl   String?

  ownerId       Int?
  owner         User?     @relation(fields: [ownerId], references: [id])

  bookings      Booking[]
  reviews       Review[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Booking {
  id               Int            @id @default(autoincrement())
  checkIn          DateTime
  checkOut         DateTime
  guestsCount      Int            @default(2)
  nights           Int
  totalPrice       Float
  status           BookingStatus  @default(PENDING)
  notes            String?

  // Trazabilidad Financiera v2.0 (RF-07 / RN-06)
  paymentStatus    PaymentStatus  @default(UNPAID)
  paymentMethod    PaymentMethod?
  paymentReference String?
  voucherCode      String?        @unique
  paidAt           DateTime?

  userId           Int
  user             User           @relation(fields: [userId], references: [id])

  hotelId          Int
  hotel            Hotel          @relation(fields: [hotelId], references: [id])

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Review {
  id             Int       @id @default(autoincrement())
  rating         Int       // 1 a 5 estrellas
  comment        String
  isVerifiedStay Boolean   @default(false) // RN-07: Verificado automáticamente por el Backend
  isFeatured     Boolean   @default(false) // Destacada por el Hotel Partner
  partnerReply   String?   // Respuesta oficial del Hotel Partner
  repliedAt      DateTime?

  userId         Int
  user           User      @relation(fields: [userId], references: [id])

  hotelId        Int
  hotel          Hotel     @relation(fields: [hotelId], references: [id])

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}