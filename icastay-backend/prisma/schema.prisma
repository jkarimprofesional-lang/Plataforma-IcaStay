generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  HOTEL_PARTNER
  ADMIN
}

enum Zone {
  HUACACHINA
  PARACAS
  ICA_CENTRO
  VINEDOS
  NAZCA
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  passwordHash     String
  role             Role      @default(GUEST)
  travelPreference String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hotels           Hotel[]
  bookings         Booking[]
}

model Hotel {
  id            Int       @id @default(autoincrement())
  name          String
  description   String
  zone          Zone
  pricePerNight Float
  imageUrl      String
  categoryTag   String
  isPartner     Boolean   @default(false)
  externalUrl   String?

  ownerId       Int?
  owner         User?     @relation(fields: [ownerId], references: [id])

  bookings      Booking[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Booking {
  id          Int           @id @default(autoincrement())
  checkIn     DateTime
  checkOut    DateTime
  guestsCount Int           @default(2)
  nights      Int
  totalPrice  Float
  status      BookingStatus @default(PENDING)
  notes       String?

  userId      Int
  user        User          @relation(fields: [userId], references: [id])

  hotelId     Int
  hotel       Hotel         @relation(fields: [hotelId], references: [id])

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}